{
  "title": "Documentation",
  "description": "Orderable pages with rich-text content, plus a Settings singleton for the site title.",
  "schema": {
    "version": 1,
    "collections": [
      {
        "name": "pages",
        "label": "Pages",
        "path": "pages",
        "fields": [
          {
            "key": "title",
            "label": "Title",
            "type": "text",
            "required": true
          },
          {
            "key": "slug",
            "label": "Slug",
            "type": "text",
            "required": true
          },
          {
            "key": "order",
            "label": "Order",
            "type": "number"
          },
          {
            "key": "body",
            "label": "Body",
            "type": "richtext"
          }
        ]
      }
    ],
    "singletons": [
      {
        "name": "settings",
        "label": "Settings",
        "path": "settings.json",
        "fields": [
          {
            "key": "title",
            "label": "Site name",
            "type": "text"
          },
          {
            "key": "tagline",
            "label": "Tagline",
            "type": "text"
          }
        ]
      }
    ]
  },
  "samples": {
    "pages": [
      {
        "title": "Getting started",
        "slug": "getting-started",
        "order": 1,
        "body": "Welcome aboard."
      }
    ]
  }
}
