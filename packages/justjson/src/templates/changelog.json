{
  "title": "Changelog",
  "description": "Release notes: version, date, type and a rich-text body.",
  "schema": {
    "version": 1,
    "collections": [
      {
        "name": "releases",
        "label": "Releases",
        "path": "releases",
        "fields": [
          {
            "key": "version",
            "label": "Version",
            "type": "text",
            "required": true
          },
          {
            "key": "slug",
            "label": "Slug",
            "type": "text",
            "required": true
          },
          {
            "key": "date",
            "label": "Date",
            "type": "date"
          },
          {
            "key": "type",
            "label": "Type",
            "type": "select",
            "options": ["Added", "Changed", "Fixed"]
          },
          {
            "key": "body",
            "label": "Notes",
            "type": "richtext"
          }
        ]
      }
    ],
    "singletons": []
  },
  "samples": {
    "releases": [
      {
        "version": "1.0.0",
        "slug": "1-0-0",
        "type": "Added",
        "body": "First release."
      }
    ]
  }
}
