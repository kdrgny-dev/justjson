{
  "title": "CV",
  "description": "An Experience collection and a Profile singleton for your personal details.",
  "schema": {
    "version": 1,
    "collections": [
      {
        "name": "experience",
        "label": "Experience",
        "path": "experience",
        "fields": [
          {
            "key": "role",
            "label": "Role",
            "type": "text",
            "required": true
          },
          {
            "key": "company",
            "label": "Company",
            "type": "text",
            "required": true
          },
          {
            "key": "summary",
            "label": "Summary",
            "type": "richtext"
          }
        ]
      }
    ],
    "singletons": [
      {
        "name": "profile",
        "label": "Profile",
        "path": "profile.json",
        "fields": [
          {
            "key": "name",
            "label": "Name",
            "type": "text",
            "required": true
          },
          {
            "key": "headline",
            "label": "Headline",
            "type": "text"
          }
        ]
      }
    ]
  },
  "samples": {
    "experience": [
      {
        "role": "Developer",
        "company": "Acme Inc.",
        "summary": "..."
      }
    ]
  }
}
