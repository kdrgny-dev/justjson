{
  "name": "justjson",
  "version": "0.0.0",
  "description": "Lokalde çalışan, JSON üreten mini CMS",
  "type": "module",
  "license": "MIT",
  "keywords": ["cms", "json", "headless", "local", "content", "git", "static-site"],
  "bin": {
    "justjson": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean",
    "dev": "tsup src/cli.ts --format esm --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@justjson/core": "workspace:*",
    "commander": "^12.1.0",
    "hono": "^4.6.14",
    "@hono/node-server": "^1.13.7"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
