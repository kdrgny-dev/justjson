{
  "name": "@justjson/editor",
  "version": "1.9.0",
  "description": "JustJSON editör arayüzü (Vite + React SPA)",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm themes:fetch && vite build",
    "build:studio": "pnpm themes:fetch && vite build --base=/studio/ --outDir ../../landing/public/studio --emptyOutDir",
    "dev": "vite",
    "preview": "vite preview",
    "demos": "node scripts/build-theme-demos.mjs",
    "thumbs": "node scripts/build-theme-thumbs.mjs",
    "themes:fetch": "node scripts/fetch-premium-themes.mjs",
    "theme:compile": "node scripts/theme-compile.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@justjson/core": "workspace:*",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/pm": "^3.29.0",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.27.0",
    "marked": "^18.0.7",
    "mustache": "^4.2.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.15.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mustache": "^4.2.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
