---
interface Props {
  progress?: boolean
  active?: string
}
const { progress = false, active } = Astro.props

const icons = {
  docs: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
  roadmap:
    '<path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/>',
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
}

const links = [
  { href: '/docs/getting-started', label: 'Docs', key: 'docs', icon: icons.docs },
  { href: '/roadmap', label: 'Roadmap', key: 'roadmap', icon: icons.roadmap },
  { href: 'https://github.com/kdrgny-dev/justjson', label: 'GitHub', key: 'github', icon: icons.github },
]

const svg = (paths: string) =>
  `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`
---

<nav>
  <div class="nav-in">
    <a class="brand" href="/" style="text-decoration: none"
      >Just<span class="br">&#123;</span><b>JSON</b><span class="br">&#125;</span></a
    >
    <div class="nav-r">
      {
        links.map((l) => (
          <a class="btn btn-ghost" href={l.href} aria-current={active === l.key ? 'page' : undefined}>
            <Fragment set:html={svg(l.icon)} />
            {l.label}
          </a>
        ))
      }
    </div>
  </div>
  {progress && <span id="progress" aria-hidden="true" />}
</nav>

<style>
  .nav-r .btn[aria-current='page'] {
    color: var(--signal-ink);
    border-color: var(--signal-ink);
  }
  .nav-r .btn svg {
    opacity: 0.8;
  }
  @media (max-width: 560px) {
    .nav-r {
      gap: 6px;
    }
    .nav-r .btn {
      padding: 8px 11px;
      font-size: 13px;
    }
  }
</style>
