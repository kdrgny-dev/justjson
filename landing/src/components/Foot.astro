---

<footer>
  <div class="wrap foot-in">
    <a class="brand" href="/" style="font-size: 15px; text-decoration: none"
      >Just<span class="br">&#123;</span><b>JSON</b><span class="br">&#125;</span></a
    >
    <span class="foot-made">
      This whole site is built with JustJSON — its words live in
      <a href="https://github.com/kdrgny-dev/justjson/tree/main/landing/content"
        ><span class="mono">landing/content/*.json</span></a
      >.
    </span>
    <span class="foot-links">
      <a href="/docs/getting-started">Docs</a>
      <a href="/templates">Templates</a>
      <a href="/roadmap">Roadmap</a>
      <a href="/vs">Compare</a>
      <a href="/tools/json-to-types">JSON→types</a>
      <a href="https://github.com/kdrgny-dev/justjson">GitHub</a>
      <a href="https://www.npmjs.com/package/@kdrgny/justjson">npm</a>
      <button class="theme-toggle" id="theme" type="button" aria-label="Toggle theme">
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 18a6 6 0 0 0 0-12z"></path>
        </svg>
        Theme
      </button>
    </span>
  </div>
</footer>

<style>
  .foot-links {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 16px;
  }
  .foot-links a {
    text-decoration: none;
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: inherit;
    font-size: inherit;
    color: var(--muted);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--signal-ink);
  }
</style>
