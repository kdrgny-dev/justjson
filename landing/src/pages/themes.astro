---
import Analytics from '@vercel/analytics/astro'
import Foot from '../components/Foot.astro'
import Nav from '../components/Nav.astro'
import Seo from '../components/Seo.astro'
import SiteScript from '../components/SiteScript.astro'
import '../styles/site.css'

const premium = [
  {
    id: 'beacon',
    name: 'Beacon',
    voice: 'Developer platform',
    blurb:
      'Deep navy lit from behind by a turning field of light. Oversized display type, glass chrome, pricing tiers and a product frame — for a SaaS or developer tool launch.',
    accent: '#4c7fff',
  },
  {
    id: 'atelier',
    name: 'Atelier',
    voice: 'Editorial & docs',
    blurb:
      'Warm paper, a serif display and hairline rules. Handles a documentation set or a multi-page content site without turning into a template.',
    accent: '#b26a43',
  },
  {
    id: 'signal',
    name: 'Signal',
    voice: 'Design portfolio',
    blurb:
      'Near-black, mono labels, work first. Project cards with covers and a quiet index — built for showing a body of work rather than talking about it.',
    accent: '#1f6feb',
  },
  {
    id: 'psikolog',
    name: 'Psikolog',
    voice: 'Therapy practice',
    blurb:
      'Calm, legible and Turkish out of the box: services with duration and fee, an FAQ, writing, and contact details where a client expects them.',
    accent: '#b26a43',
  },
]

const free = [
  {
    id: 'default',
    name: 'Default',
    blurb: 'Clean and neutral — the theme every new project starts with.',
  },
  {
    id: 'bold',
    name: 'Bold',
    blurb: 'High-contrast type and heavy headings for a site with a voice.',
  },
  {
    id: 'editorial',
    name: 'Editorial',
    blurb: 'Serif body copy and generous measure, tuned for long reading.',
  },
]

const title = 'JustJSON themes — four premium designs, three free ones'
const description =
  'Live demos of every JustJSON theme: Beacon for a developer platform, Atelier for docs, Signal for a portfolio, Psikolog for a therapy practice — plus three free themes in Studio.'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo title={title} description={description} url="https://justjson.dev/themes" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Public+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      .thm-head { padding: 60px 24px 0; }
      .thm-head h1 { margin: 14px 0 0; }
      .thm-head .lead { max-width: 62ch; margin: 16px 0 0; }
      .thm-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin: 30px 0 20px; }
      .thm-card { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--raised); box-shadow: var(--shadow); }
      .thm-shot { display: block; aspect-ratio: 16 / 10; overflow: hidden; border-bottom: 1px solid var(--line); background: var(--sunk); position: relative; }
      .thm-shot img { position: relative; z-index: 1; width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
      /* Until a thumb.jpg exists the frame carries the theme's own accent, so a
         missing screenshot reads as a swatch rather than a broken image. */
      .thm-fallback { position: absolute; inset: 0; z-index: 0; display: grid; place-items: center; background:
        radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--tone) 55%, transparent), transparent 70%), var(--sunk); }
      .thm-fallback span { font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
      .thm-body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
      .thm-row { display: flex; align-items: center; gap: 10px; }
      .thm-row h3 { font-family: var(--sans); font-size: 1.12rem; font-weight: 700; margin: 0; }
      .thm-voice { font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--signal-ink); }
      .thm-badge { font-family: var(--mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 7px; border-radius: 5px; background: color-mix(in srgb, var(--signal) 18%, transparent); color: var(--signal-ink); margin-left: auto; }
      .thm-badge.free { background: color-mix(in srgb, var(--kraft) 22%, transparent); color: var(--kraft-ink); }
      .thm-body p { margin: 0; color: var(--muted); font-size: 0.92rem; flex: 1; }
      .thm-foot { display: flex; align-items: center; gap: 12px; margin-top: 6px; }
      .thm-live { font-family: var(--mono); font-size: 12px; font-weight: 700; color: var(--signal-ink); text-decoration: none; }
      .thm-live:hover { text-decoration: underline; }
      .thm-sub { margin: 46px 0 0; }
      .thm-sub h2 { margin: 0; font-size: 1.3rem; }
      .thm-sub p { color: var(--muted); margin: 8px 0 0; max-width: 62ch; }
      .thm-free { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 20px 0 0; }
      .thm-free .thm-card { padding: 16px 18px 18px; }
      .thm-note { color: var(--faint); font-size: 0.9rem; margin: 34px 2px 80px; max-width: 70ch; }
      @media (max-width: 860px) {
        .thm-grid, .thm-free { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <Nav active="themes" />

    <header class="wrap thm-head">
      <span class="eyebrow">Themes</span>
      <h1>Four premium designs, three free ones</h1>
      <p class="lead">
        Every theme renders your own content — the same JSON files, a different site. Open a demo,
        click through its pages, then build the same thing with your words in Studio.
      </p>
    </header>

    <section class="wrap">
      <div class="thm-grid">
        {
          premium.map((t) => (
            <article class="thm-card">
              <a
                class="thm-shot"
                href={`/themes/${t.id}/index.html`}
                style={`--tone: ${t.accent}`}
                aria-label={`${t.name} theme — open the live demo`}
              >
                <span class="thm-fallback" aria-hidden="true">
                  <span>{t.name}</span>
                </span>
                <img
                  src={`/themes/${t.id}/thumb.jpg`}
                  alt={`The ${t.name} theme's home page — ${t.voice.toLowerCase()}`}
                  width="1600"
                  height="1000"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="thm-body">
                <span class="thm-voice">{t.voice}</span>
                <div class="thm-row">
                  <h3>{t.name}</h3>
                  <span class="thm-badge">Pro</span>
                </div>
                <p>{t.blurb}</p>
                <div class="thm-foot">
                  <a class="thm-live" href={`/themes/${t.id}/index.html`}>Live demo ↗</a>
                  <a class="thm-live" href="/#pricing" style="margin-left: auto">Get all four →</a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div class="thm-sub">
        <h2>Free with Studio</h2>
        <p>
          These three ship with the editor and stay free — MIT licensed, like the rest of the CMS.
          You can publish as many sites as you like with them.
        </p>
        <div class="thm-free">
          {
            free.map((t) => (
              <article class="thm-card">
                <div class="thm-row">
                  <h3>{t.name}</h3>
                  <span class="thm-badge free">Free</span>
                </div>
                <p style="margin-top: 8px">{t.blurb}</p>
              </article>
            ))
          }
        </div>
      </div>

      <p class="thm-note">
        The demos above use each theme's sample content, published as static files — the same output
        Studio produces for your site. Premium themes are licensed separately from the MIT-licensed
        CMS; one purchase covers every site you build.
      </p>
    </section>

    <Foot />
    <Analytics />
    <SiteScript />
  </body>
</html>
