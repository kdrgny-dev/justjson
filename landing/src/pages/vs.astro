---
import Analytics from '@vercel/analytics/astro'
import '../styles/site.css'

type Row = Record<string, any>
function collection(glob: Record<string, { default: Row }>): Row[] {
  return Object.values(glob)
    .map((m) => m.default)
    .sort((a, b) => (a.order ?? 0) - (b.order ?? 0))
}

const products = collection(import.meta.glob('../../content/vs/*.json', { eager: true }))

const criteria = [
  { k: 'account', label: 'Account' },
  { k: 'server', label: 'Server / database' },
  { k: 'apiKey', label: 'API key' },
  { k: 'localFirst', label: 'Local-first / offline' },
  { k: 'typed', label: 'Typed output' },
  { k: 'deploy', label: 'Site + deploy' },
  { k: 'oss', label: 'License' },
  { k: 'bestFor', label: 'Best for' },
]

const title = 'JustJSON vs Keystatic, Decap, Tina — a plain-files CMS comparison'
const description =
  'How JustJSON compares to Keystatic, Decap, Tina and hosted headless CMSs: no account, no server, no API key — your content stays in your repo as plain JSON.'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e8ae3e" />
    <link rel="canonical" href="https://justjson.vercel.app/vs" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Public+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      .vs-head {
        padding: 60px 24px 0;
      }
      .vs-head h1 {
        margin: 14px 0 0;
      }
      .vs-head .lead {
        max-width: 60ch;
        margin: 16px 0 0;
      }
      .vs-block {
        padding: 28px 0 0;
      }
      table.cmp .ptag {
        display: block;
        margin-top: 5px;
        font-family: var(--sans);
        font-size: 11.5px;
        line-height: 1.4;
        letter-spacing: 0;
        text-transform: none;
        color: var(--faint);
        font-weight: 400;
        max-width: 26ch;
      }
      table.cmp tbody tr {
        opacity: 1;
        transform: none;
      }
      table.cmp tbody tr.us-row th,
      table.cmp tbody tr.us-row td {
        background: color-mix(in srgb, var(--signal) 8%, transparent);
      }
      table.cmp tbody tr.us-row th {
        color: var(--signal-ink);
      }
      .vs-note {
        margin: 18px 2px 0;
        color: var(--faint);
        font-size: 0.9rem;
        max-width: 70ch;
      }
      .vs-cta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        margin: 26px 0 80px;
      }
      .vs-cta .cmd {
        margin-top: 0;
      }
    </style>
  </head>
  <body>
    <nav>
      <div class="nav-in">
        <a class="brand" href="/" style="text-decoration: none">Just<b>JSON</b></a>
        <div class="nav-r">
          <button class="icon-btn" id="theme" aria-label="Toggle theme" title="Theme">◐</button>
          <a class="btn btn-ghost" href="https://github.com/kdrgny-dev/justjson">GitHub</a>
        </div>
      </div>
    </nav>

    <header class="wrap vs-head">
      <span class="eyebrow">Honest comparison</span>
      <h1>JustJSON vs the alternatives</h1>
      <p class="lead">
        Most content tools put a company, a database or an API key between you and your words.
        Here is where JustJSON sits next to the closest options — including the ones we admire.
      </p>
    </header>

    <section class="wrap vs-block">
      <div class="cmp-wrap">
        <table class="cmp" style="min-width: 900px">
          <thead>
            <tr>
              <th scope="col">Tool</th>
              <th scope="col">Account</th>
              <th scope="col">Server / DB</th>
              <th scope="col">API key</th>
              <th scope="col">Local-first</th>
              <th scope="col">Typed output</th>
              <th scope="col">Best for</th>
            </tr>
          </thead>
          <tbody>
            {
              products.map((p) => (
                <tr class={p.isUs ? 'us-row' : ''}>
                  <th scope="row">
                    {p.name}
                    <span class="ptag">{p.tagline}</span>
                  </th>
                  <td>{p.account}</td>
                  <td>{p.server}</td>
                  <td>{p.apiKey}</td>
                  <td>{p.localFirst}</td>
                  <td>{p.typed}</td>
                  <td>{p.bestFor}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="vs-note">
        A fair-use summary of publicly documented behaviour, compiled {new Date().getFullYear()}.
        Tools evolve — <a href="https://github.com/kdrgny-dev/justjson/issues/new">tell us</a> if
        anything reads wrong and we'll fix it. Keystatic, Decap and Tina are excellent projects;
        JustJSON's edge is starting from nothing in one command.
      </p>

      <div class="vs-cta">
        <div class="cmd">
          <span><span class="prompt">$</span> npx @kdrgny/justjson</span>
          <button data-copy="npx @kdrgny/justjson" aria-label="Copy command">Copy</button>
        </div>
        <a
          class="btn btn-ghost"
          href="https://stackblitz.com/github/kdrgny-dev/justjson/tree/main/examples/playground"
          target="_blank"
          rel="noreferrer">Try in your browser</a
        >
        <a class="btn btn-ghost" href="/">Back to home</a>
      </div>
    </section>

    <footer>
      <div class="wrap foot-in">
        <a class="brand" href="/" style="font-size: 15px; text-decoration: none">Just<b>JSON</b></a>
        <span class="foot-made">
          This page is built with JustJSON — its rows live in
          <a href="https://github.com/kdrgny-dev/justjson/tree/main/landing/content/vs"
            ><span class="mono">landing/content/vs/*.json</span></a
          >.
        </span>
        <span>
          <a href="https://github.com/kdrgny-dev/justjson">GitHub</a> &nbsp;·&nbsp;
          <a href="https://www.npmjs.com/package/@kdrgny/justjson">npm</a> &nbsp;·&nbsp;
          <a href="https://github.com/kdrgny-dev/justjson/blob/main/LICENSE">MIT</a>
        </span>
      </div>
    </footer>

    <Analytics />

    <script>
      const root = document.documentElement
      document.getElementById('theme')?.addEventListener('click', () => {
        const cur = root.getAttribute('data-theme')
        const dark = cur === 'dark' || (!cur && matchMedia('(prefers-color-scheme: dark)').matches)
        const next = dark ? 'light' : 'dark'
        root.setAttribute('data-theme', next)
        try {
          localStorage.setItem('jj-theme', next)
        } catch {}
      })
      try {
        const saved = localStorage.getItem('jj-theme')
        if (saved) root.setAttribute('data-theme', saved)
      } catch {}

      document.querySelectorAll('[data-copy]').forEach((el) => {
        el.addEventListener('click', () => {
          const v = el.getAttribute('data-copy') || ''
          navigator.clipboard?.writeText(v)
          const t = el.textContent
          el.textContent = 'Copied'
          setTimeout(() => {
            el.textContent = t
          }, 1400)
        })
      })
    </script>
  </body>
</html>
