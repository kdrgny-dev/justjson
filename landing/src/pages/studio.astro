---
// JustJSON Studio — no-backend browser publish (SPIKE).
// Proves the whole thesis: a fully static page (no server, no DB) that lets a
// non-dev build a tiny site and publish it to THEIR OWN Netlify account via
// browser-side implicit OAuth + the Netlify deploy API. We host nothing, store
// nothing. If this loop works in prod (esp. CORS to api.netlify.com), the rest
// (real editor, templates, Ed25519 license, Vercel adapter via a stateless
// broker) is known-buildable.
//
// Setup the site owner must do once: register a Netlify OAuth app
// (User settings > Applications > New OAuth app), redirect URI =
// https://justjson.vercel.app/studio (+ http://localhost:4322/studio for dev),
// then paste its Client ID below. The implicit-flow client ID is public.
const NETLIFY_CLIENT_ID = 'Knha7tY8sVFmH9fHvOhz5mRjhfNh7nDEl4DwLnOGhUs'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Studio — JustJSON</title>
    <style>
      :root {
        --bg: #17130d; --raised: #201a11; --ink: #f1e8d2; --muted: #b7a883;
        --line: #362b1a; --signal: #e8ae3e; --signal-ink: #f6c567;
        --moss: #9cae79; --rust: #e07a4e;
        --mono: "Space Mono", ui-monospace, Menlo, monospace;
        --sans: "Public Sans", ui-sans-serif, system-ui, sans-serif;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--ink);
        font-family: var(--sans); line-height: 1.5; min-height: 100vh; }
      .top { border-bottom: 1px solid var(--line); padding: 14px 20px;
        display: flex; align-items: center; gap: 12px; }
      .brand { font-family: var(--mono); font-weight: 700; font-size: 15px; }
      .brand b { color: var(--signal); }
      .pill { font-family: var(--mono); font-size: 10px; text-transform: uppercase;
        letter-spacing: 0.06em; color: var(--signal-ink);
        border: 1px solid var(--line); border-radius: 999px; padding: 3px 8px; }
      .grid { display: grid; grid-template-columns: 380px 1fr; min-height: calc(100vh - 51px); }
      .panel { padding: 24px; border-right: 1px solid var(--line); }
      h1 { font-size: 1.2rem; margin: 0 0 4px; }
      .sub { color: var(--muted); font-size: 0.85rem; margin: 0 0 22px; }
      label { display: block; font-family: var(--mono); font-size: 11px;
        text-transform: uppercase; letter-spacing: 0.06em; color: var(--signal-ink);
        margin: 16px 0 6px; }
      input, textarea { width: 100%; background: var(--bg); color: var(--ink);
        border: 1px solid var(--line); border-radius: 6px; padding: 10px 12px;
        font-family: var(--sans); font-size: 0.95rem; }
      textarea { min-height: 80px; resize: vertical; }
      input:focus, textarea:focus { outline: none; border-color: var(--signal); }
      button { font-family: var(--sans); font-weight: 700; font-size: 0.95rem;
        background: var(--signal); color: #17130d; border: 0; border-radius: 6px;
        padding: 12px 22px; cursor: pointer; width: 100%; margin-top: 22px; }
      button:disabled { opacity: 0.5; cursor: default; }
      .msg { font-family: var(--mono); font-size: 12.5px; margin-top: 14px; min-height: 1.2em; }
      .msg.ok { color: var(--moss); } .msg.err { color: var(--rust); }
      .msg a { color: inherit; }
      .prev { background: #fff; }
      iframe { width: 100%; height: 100%; border: 0; display: block; }
      @media (max-width: 800px) { .grid { grid-template-columns: 1fr; } .prev { min-height: 320px; } }
    </style>
  </head>
  <body>
    <div class="top">
      <span class="brand">Just<b>&#123;JSON&#125;</b> Studio</span>
      <span class="pill">no backend · publishes to your host</span>
    </div>

    <div class="grid">
      <div class="panel">
        <h1>Build a site</h1>
        <p class="sub">Fill it in, hit publish. It deploys to your own Netlify — nothing is stored here.</p>

        <label for="title">Site title</label>
        <input id="title" type="text" value="Ayşe'nin Mantı Evi" />

        <label for="tagline">Tagline</label>
        <input id="tagline" type="text" value="El açması, günlük taze." />

        <label for="body">About</label>
        <textarea id="body">1998'den beri ev yapımı mantı. Sipariş için arayın.</textarea>

        <label for="cta">Phone / contact</label>
        <input id="cta" type="text" value="0555 123 45 67" />

        <button id="publish" type="button">Connect Netlify &amp; publish</button>
        <p id="msg" class="msg"></p>
      </div>

      <div class="prev">
        <iframe id="preview" title="Preview"></iframe>
      </div>
    </div>

    <script define:vars={{ NETLIFY_CLIENT_ID }}>
      const $ = (id) => document.getElementById(id)
      const fields = ['title', 'tagline', 'body', 'cta']
      const REDIRECT = location.origin + '/studio'

      // ---- generate the static site (in the browser) ----
      function esc(s) {
        return String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c])
      }
      function buildHTML() {
        const t = $('title').value, tag = $('tagline').value, body = $('body').value, cta = $('cta').value
        return `<!doctype html><html lang="tr"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>${esc(t)}</title>
<style>
  :root{--a:#d69a1f;--ink:#241c10;--bg:#f7f1e4}
  *{box-sizing:border-box}body{margin:0;font-family:system-ui,sans-serif;background:var(--bg);color:var(--ink)}
  .hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px}
  h1{font-size:clamp(2rem,6vw,3.5rem);margin:0 0 10px}
  .tag{font-size:1.2rem;color:#6e6248;margin:0 0 28px}
  p{max-width:52ch;line-height:1.6;font-size:1.05rem}
  .cta{margin-top:28px;display:inline-block;background:var(--a);color:#241c10;font-weight:700;
    text-decoration:none;padding:14px 28px;border-radius:8px}
  footer{padding:20px;text-align:center;color:#9c8f6e;font-size:.85rem}
</style></head><body>
<div class="hero"><h1>${esc(t)}</h1><p class="tag">${esc(tag)}</p><p>${esc(body)}</p>
<a class="cta" href="tel:${esc(cta).replace(/\\s/g, '')}">${esc(cta)}</a></div>
<footer>Made with Just{JSON}</footer></body></html>`
      }
      function refresh() {
        $('preview').srcdoc = buildHTML()
      }
      fields.forEach((f) => $(f).addEventListener('input', refresh))
      refresh()

      // ---- Netlify OAuth (implicit, browser-only) ----
      function tokenFromHash() {
        const h = new URLSearchParams(location.hash.slice(1))
        const t = h.get('access_token')
        if (t) { history.replaceState(null, '', location.pathname); sessionStorage.setItem('nf_token', t) }
        return t || sessionStorage.getItem('nf_token')
      }
      function connect() {
        if (NETLIFY_CLIENT_ID.includes('PLACEHOLDER')) {
          fail('Netlify OAuth app not configured yet (need the Client ID).'); return null
        }
        const u = `https://app.netlify.com/authorize?client_id=${encodeURIComponent(NETLIFY_CLIENT_ID)}` +
          `&response_type=token&redirect_uri=${encodeURIComponent(REDIRECT)}`
        location.href = u
      }

      // ---- Netlify deploy (digest method, single file, zero deps) ----
      async function sha1(str) {
        const buf = await crypto.subtle.digest('SHA-1', new TextEncoder().encode(str))
        return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('')
      }
      const NF = 'https://api.netlify.com/api/v1'
      async function deploy(token) {
        const html = buildHTML()
        const digest = await sha1(html)
        const auth = { Authorization: 'Bearer ' + token }

        ok('Creating site…')
        const siteRes = await fetch(`${NF}/sites`, { method: 'POST', headers: auth })
        if (!siteRes.ok) throw new Error('create site failed: ' + siteRes.status + ' ' + (await siteRes.text()))
        const site = await siteRes.json()

        ok('Uploading…')
        const depRes = await fetch(`${NF}/sites/${site.id}/deploys`, {
          method: 'POST', headers: { ...auth, 'Content-Type': 'application/json' },
          body: JSON.stringify({ files: { '/index.html': digest } }),
        })
        if (!depRes.ok) throw new Error('deploy failed: ' + depRes.status + ' ' + (await depRes.text()))
        let dep = await depRes.json()

        if ((dep.required || []).includes(digest)) {
          const up = await fetch(`${NF}/deploys/${dep.id}/files/index.html`, {
            method: 'PUT', headers: { ...auth, 'Content-Type': 'application/octet-stream' }, body: html,
          })
          if (!up.ok) throw new Error('upload failed: ' + up.status + ' ' + (await up.text()))
          dep = await up.json()
        }
        return site.ssl_url || site.url || ('https://' + site.name + '.netlify.app')
      }

      // ---- glue ----
      const btn = $('publish'), msg = $('msg')
      function ok(t) { msg.className = 'msg'; msg.textContent = t }
      function done(t) { msg.className = 'msg ok'; msg.innerHTML = t }
      function fail(t) { msg.className = 'msg err'; msg.textContent = t }

      async function run() {
        let token = tokenFromHash()
        if (!token) { connect(); return }
        btn.disabled = true
        try {
          const url = await deploy(token)
          done(`Live ✓ <a href="${url}" target="_blank" rel="noreferrer">${url}</a>`)
        } catch (e) {
          if ((e.message || '').includes('401')) { sessionStorage.removeItem('nf_token'); fail('Session expired — click again to reconnect.') }
          else fail(e.message)
        } finally { btn.disabled = false }
      }
      btn.addEventListener('click', run)
      // returning from OAuth with a token in the hash → auto-continue
      if (location.hash.includes('access_token')) run()
    </script>
  </body>
</html>
