---
import { marked } from 'marked'
import Analytics from '@vercel/analytics/astro'
import Foot from '../components/Foot.astro'
import Nav from '../components/Nav.astro'
import Seo from '../components/Seo.astro'
import SiteScript from '../components/SiteScript.astro'
import '../styles/site.css'

type Row = Record<string, any>
function collection(glob: Record<string, { default: Row }>): Row[] {
  return Object.values(glob)
    .map((m) => m.default)
    .sort((a, b) => (a.order ?? 0) - (b.order ?? 0))
}

const roadmap = collection(import.meta.glob('../../content/roadmap/*.json', { eager: true }))
const releases = collection(import.meta.glob('../../content/releases/*.json', { eager: true }))

const groups = [
  { key: 'shipped', label: 'Shipped' },
  { key: 'in-progress', label: 'In progress' },
  { key: 'planned', label: 'Planned' },
  { key: 'exploring', label: 'Exploring' },
]

const fmtDate = (d: string) =>
  d ? new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }) : ''

const title = 'JustJSON — roadmap & releases'
const description =
  'What has shipped, what is planned, and every release of JustJSON — the local, file-based CMS.'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo title={title} description={description} url="https://justjson.dev/roadmap" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Public+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      .rm-head {
        padding: 60px 24px 0;
      }
      .rm-head h1 {
        margin: 14px 0 0;
      }
      .rm-head .lead {
        max-width: 58ch;
        margin: 16px 0 0;
      }
      .board {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
        margin-top: 30px;
      }
      .col {
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--raised);
        overflow: hidden;
      }
      .col-head {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border-bottom: 1px solid var(--line);
        background: var(--sunk);
        font-family: var(--mono);
        font-size: 12px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .col-head .dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        flex: none;
      }
      .col.shipped .dot {
        background: var(--moss);
      }
      .col.in-progress .dot {
        background: var(--signal);
      }
      .col.planned .dot {
        background: var(--faint);
      }
      .col.exploring .dot {
        background: var(--rust);
      }
      .col-head .count {
        margin-left: auto;
        color: var(--faint);
      }
      .col ul {
        list-style: none;
        margin: 0;
        padding: 6px 0;
      }
      .col li {
        padding: 11px 16px;
      }
      .col li + li {
        border-top: 1px solid var(--line-soft);
      }
      .col li h3 {
        font-family: var(--sans);
        font-size: 0.98rem;
        font-weight: 700;
        margin: 0;
      }
      .col.shipped li h3::before {
        content: '✓ ';
        color: var(--moss);
      }
      .col li p {
        margin: 4px 0 0;
        color: var(--muted);
        font-size: 0.9rem;
      }
      .rel-head {
        margin: 64px 0 0;
      }
      .changelog {
        margin: 24px 0 0;
        border-left: 2px solid var(--line);
        padding-left: 24px;
        display: grid;
        gap: 26px;
      }
      .rel {
        position: relative;
      }
      .rel::before {
        content: '';
        position: absolute;
        left: -31px;
        top: 4px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--signal);
        box-shadow: 0 0 0 4px var(--ground);
      }
      .rel-top {
        display: flex;
        align-items: baseline;
        gap: 12px;
        flex-wrap: wrap;
      }
      .rel-ver {
        font-family: var(--mono);
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--signal-ink);
      }
      .rel-date {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--faint);
      }
      .rel-title {
        font-weight: 700;
      }
      .rel-body {
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 0.94rem;
      }
      .rel-body :global(ul) {
        margin: 0;
        padding-left: 18px;
      }
      .rel-body :global(li) {
        margin: 4px 0;
      }
      .rel-body :global(code) {
        font-family: var(--mono);
        font-size: 0.85em;
        background: color-mix(in srgb, var(--kraft) 24%, transparent);
        color: var(--kraft-ink);
        padding: 1px 5px;
        border-radius: 4px;
      }
      .rel-body :global(strong) {
        color: var(--ink);
      }
      .rm-foot-note {
        margin: 46px 0 80px;
        color: var(--faint);
        font-size: 0.9rem;
      }
      @media (max-width: 640px) {
        .board {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <Nav active="roadmap" />

    <header class="wrap rm-head">
      <span class="eyebrow">Roadmap</span>
      <h1>What's shipped, what's next</h1>
      <p class="lead">
        JustJSON is built in the open. Here's the state of things and every release so far — and,
        like the rest of this site, it's a JustJSON project you can read in the repo.
      </p>
    </header>

    <section class="wrap">
      <div class="board">
        {
          groups.map((g) => {
            const items = roadmap.filter((r) => r.status === g.key)
            return (
              <div class={`col ${g.key}`}>
                <div class="col-head">
                  <span class="dot" />
                  {g.label}
                  <span class="count">{items.length}</span>
                </div>
                <ul>
                  {items.map((r) => (
                    <li>
                      <h3>{r.title}</h3>
                      {r.body && <p>{r.body}</p>}
                    </li>
                  ))}
                </ul>
              </div>
            )
          })
        }
      </div>

      <div class="head rel-head">
        <span class="eyebrow">Releases</span>
        <h2>Changelog</h2>
      </div>
      <div class="changelog">
        {
          releases.map((r) => (
            <div class="rel">
              <div class="rel-top">
                <span class="rel-ver">v{r.version}</span>
                {r.title && <span class="rel-title">{r.title}</span>}
                {r.date && <span class="rel-date">{fmtDate(r.date)}</span>}
              </div>
              <div class="rel-body" set:html={marked.parse(r.body || '')} />
            </div>
          ))
        }
      </div>

      <p class="rm-foot-note">
        Have an idea? <a href="https://github.com/kdrgny-dev/justjson/issues/new">Open an issue</a> —
        the roadmap is shaped in the open.
      </p>
    </section>

    <Foot />
    <Analytics />
    <SiteScript />
  </body>
</html>
