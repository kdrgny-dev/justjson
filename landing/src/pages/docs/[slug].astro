---
import { marked } from 'marked'
import Analytics from '@vercel/analytics/astro'
import Foot from '../../components/Foot.astro'
import Nav from '../../components/Nav.astro'
import SiteScript from '../../components/SiteScript.astro'
import '../../styles/site.css'

type Doc = Record<string, any>

const all = Object.values(
  import.meta.glob('../../../content/docs/*.json', { eager: true }) as Record<string, { default: Doc }>,
)
  .map((m) => m.default)
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0))

export async function getStaticPaths() {
  const docs = Object.values(
    import.meta.glob('../../../content/docs/*.json', { eager: true }) as Record<
      string,
      { default: Doc }
    >,
  ).map((m) => m.default)
  return docs.map((d) => ({ params: { slug: d.slug }, props: { doc: d } }))
}

const { doc } = Astro.props

// Sidebar grouped by category, categories ordered by their first entry.
const cats: { name: string; items: Doc[] }[] = []
for (const d of all) {
  const name = d.category || 'Docs'
  let c = cats.find((x) => x.name === name)
  if (!c) {
    c = { name, items: [] }
    cats.push(c)
  }
  c.items.push(d)
}

const idx = all.findIndex((d) => d.slug === doc.slug)
const prev = idx > 0 ? all[idx - 1] : null
const next = idx < all.length - 1 ? all[idx + 1] : null

const title = `${doc.title} — JustJSON docs`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={doc.summary || 'JustJSON documentation.'} />
    <meta name="theme-color" content="#e8ae3e" />
    <link rel="canonical" href={`https://justjson.vercel.app/docs/${doc.slug}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Public+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      .docs {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 40px 24px 80px;
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 44px;
        align-items: start;
      }
      .side {
        position: sticky;
        top: 78px;
        align-self: start;
      }
      .side .cat {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--faint);
        margin: 18px 0 8px;
      }
      .side .cat:first-child {
        margin-top: 0;
      }
      .side a {
        display: block;
        padding: 6px 10px;
        border-radius: 6px;
        color: var(--muted);
        text-decoration: none;
        font-size: 0.94rem;
      }
      .side a:hover {
        color: var(--ink);
        background: var(--sunk);
      }
      .side a.on {
        color: var(--signal-ink);
        background: color-mix(in srgb, var(--signal) 10%, transparent);
        font-weight: 600;
      }
      .doc-main {
        min-width: 0;
      }
      .doc-main .kicker {
        font-family: var(--mono);
        font-size: 12px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--signal-ink);
      }
      .doc-main h1 {
        font-family: var(--mono);
        font-size: clamp(1.7rem, 4vw, 2.1rem);
        letter-spacing: -0.015em;
        margin: 10px 0 0;
        text-wrap: balance;
      }
      .doc-main .summary {
        color: var(--muted);
        font-size: 1.05rem;
        margin: 12px 0 0;
      }
      .prose {
        margin-top: 26px;
        border-top: 1px solid var(--line-soft);
        padding-top: 26px;
      }
      .prose :global(h2) {
        font-family: var(--mono);
        font-size: 1.2rem;
        margin: 30px 0 10px;
      }
      .prose :global(h3) {
        font-size: 1.02rem;
        margin: 22px 0 8px;
      }
      .prose :global(p) {
        margin: 0 0 14px;
        line-height: 1.7;
      }
      .prose :global(ul) {
        margin: 0 0 14px;
        padding-left: 20px;
      }
      .prose :global(li) {
        margin: 6px 0;
      }
      .prose :global(a) {
        color: var(--signal-ink);
      }
      .prose :global(strong) {
        color: var(--ink);
      }
      .prose :global(code) {
        font-family: var(--mono);
        font-size: 0.86em;
        background: color-mix(in srgb, var(--kraft) 22%, transparent);
        color: var(--kraft-ink);
        padding: 1px 6px;
        border-radius: 4px;
      }
      .prose :global(pre) {
        background: var(--code-bg);
        color: var(--code-ink);
        border-radius: 8px;
        padding: 16px;
        overflow-x: auto;
        border: 1px solid color-mix(in srgb, var(--code-ink) 14%, transparent);
      }
      .prose :global(pre code) {
        background: none;
        color: inherit;
        padding: 0;
        font-size: 13px;
      }
      .docnav {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-top: 40px;
        border-top: 1px solid var(--line-soft);
        padding-top: 20px;
      }
      .docnav a {
        color: var(--signal-ink);
        text-decoration: none;
        font-family: var(--mono);
        font-size: 13px;
      }
      @media (max-width: 780px) {
        .docs {
          grid-template-columns: 1fr;
          gap: 26px;
        }
        .side {
          position: static;
          border: 1px solid var(--line);
          border-radius: 10px;
          padding: 14px 16px;
          background: var(--raised);
        }
      }
    </style>
  </head>
  <body>
    <Nav active="docs" />

    <div class="docs">
      <aside class="side">
        {
          cats.map((c) => (
            <div>
              <div class="cat">{c.name}</div>
              {c.items.map((d) => (
                <a href={`/docs/${d.slug}`} class={d.slug === doc.slug ? 'on' : ''}>
                  {d.title}
                </a>
              ))}
            </div>
          ))
        }
      </aside>

      <main class="doc-main">
        <span class="kicker">{doc.category || 'Docs'}</span>
        <h1>{doc.title}</h1>
        {doc.summary && <p class="summary">{doc.summary}</p>}
        <div class="prose" set:html={marked.parse(doc.body || '')} />

        <div class="docnav">
          <span>{prev && <a href={`/docs/${prev.slug}`}>← {prev.title}</a>}</span>
          <span>{next && <a href={`/docs/${next.slug}`}>{next.title} →</a>}</span>
        </div>
      </main>
    </div>

    <Foot />
    <Analytics />
    <SiteScript />
  </body>
</html>
