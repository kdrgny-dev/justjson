---
import Analytics from '@vercel/analytics/astro'
import Foot from '../components/Foot.astro'
import Nav from '../components/Nav.astro'
import Seo from '../components/Seo.astro'
import SiteScript from '../components/SiteScript.astro'
import '../styles/site.css'

const templates = [
  {
    id: 'portfolio',
    name: 'Portfolio',
    voice: 'Studio Bold',
    blurb: 'Dark ink canvas, electric fuchsia, oversized outlined type and an asymmetric project grid.',
    preset: 'portfolio',
  },
  {
    id: 'cv',
    name: 'CV / Résumé',
    voice: 'Editorial Dossier',
    blurb: 'Paper, hairline rules, a serif–sans pairing and a print-ready two-column dossier.',
    preset: 'cv',
  },
  {
    id: 'event',
    name: 'Event',
    voice: 'Marquee',
    blurb: 'Plum + tangerine duo-tone, a scrolling marquee and a departures-board schedule.',
    preset: 'event',
  },
]

const title = 'JustJSON templates — pick a design, fill it in, publish'
const description =
  'Ready-made site designs for JustJSON: portfolio, CV and event. Pick one, fill in your content, and publish — the content stays yours as plain JSON.'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo title={title} description={description} url="https://justjson.dev/templates" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Public+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      .tpl-head { padding: 60px 24px 0; }
      .tpl-head h1 { margin: 14px 0 0; }
      .tpl-head .lead { max-width: 60ch; margin: 16px 0 0; }
      .tpl-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin: 30px 0 20px; }
      .tpl-card { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--raised); box-shadow: var(--shadow); }
      .tpl-thumb { display: block; aspect-ratio: 4 / 3; overflow: hidden; border-bottom: 1px solid var(--line); background: var(--sunk); }
      .tpl-thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
      .tpl-body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
      .tpl-body .voice { font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--signal-ink); }
      .tpl-body h3 { font-family: var(--sans); font-size: 1.08rem; font-weight: 700; margin: 0; }
      .tpl-body p { margin: 0; color: var(--muted); font-size: 0.9rem; flex: 1; }
      .tpl-foot { display: flex; align-items: center; gap: 12px; margin-top: 8px; }
      .tpl-foot .cmd { font-family: var(--mono); font-size: 11px; color: var(--kraft-ink); background: color-mix(in srgb, var(--kraft) 22%, transparent); border-radius: 5px; padding: 3px 8px; }
      .tpl-live { font-family: var(--mono); font-size: 12px; font-weight: 700; color: var(--signal-ink); text-decoration: none; margin-left: auto; }
      .tpl-live:hover { text-decoration: underline; }
      .tpl-note { color: var(--faint); font-size: 0.9rem; margin: 4px 2px 80px; max-width: 68ch; }
      @media (max-width: 860px) { .tpl-grid { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <Nav />

    <header class="wrap tpl-head">
      <span class="eyebrow">Templates</span>
      <h1>Pick a design, fill it in, publish</h1>
      <p class="lead">
        Ready-made site designs — each with its own point of view. Choose one, enter your content in
        the editor, and ship. As always, the content stays yours as plain JSON.
      </p>
    </header>

    <section class="wrap">
      <div class="tpl-grid">
        {
          templates.map((t) => (
            <article class="tpl-card">
              <a class="tpl-thumb" href={`/templates/${t.id}.html`} target="_blank" rel="noreferrer">
                <img
                  src={`/templates/thumb-${t.id}.png`}
                  alt={`${t.name} template — ${t.voice}`}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="tpl-body">
                <span class="voice">{t.voice}</span>
                <h3>{t.name}</h3>
                <p>{t.blurb}</p>
                <div class="tpl-foot">
                  <span class="cmd">init {t.preset}</span>
                  <a class="tpl-live" href={`/templates/${t.id}.html`} target="_blank" rel="noreferrer">
                    Live demo ↗
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <p class="tpl-note">
        Each is a one-command preset — run
        <span class="mono">npx @kdrgny/justjson init &lt;preset&gt; --astro</span> to generate the design
        around your own content. The live demos above use sample content; everything stays yours as
        plain JSON.
      </p>
    </section>

    <Foot />
    <Analytics />
    <SiteScript />
  </body>
</html>
